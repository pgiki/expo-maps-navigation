{
  "name": "expo-maps-navigation",
  "version": "0.1.0",
  "description": "Turn-by-turn navigation for Expo using expo-maps and OSRM.",
  "source": "./src/index.tsx",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "react-native": "./src/index.tsx",
  "exports": {
    ".": {
      "react-native": "./src/index.tsx",
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    }
  },
  "files": [
    "src",
    "lib",
    "patches",
    "docs",
    "CHANGELOG.md",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "prepublishOnly": "bob build",
    "build": "bob build"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-maps",
    "navigation",
    "osrm",
    "turn-by-turn",
    "ios",
    "android"
  ],
  "license": "MIT",
  "author": "expo-maps-navigation contributors",
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/fikachu/expo-maps-navigation#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fikachu/expo-maps-navigation.git"
  },
  "bugs": {
    "url": "https://github.com/fikachu/expo-maps-navigation/issues"
  },
  "peerDependencies": {
    "expo": "*",
    "expo-image": "*",
    "expo-keep-awake": "*",
    "expo-location": "*",
    "expo-maps": "*",
    "expo-speech": "*",
    "lucide-react-native": "*",
    "react": "*",
    "react-native": "*",
    "react-native-safe-area-context": "*",
    "react-native-svg": "*"
  },
  "peerDependenciesMeta": {
    "expo-keep-awake": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "del-cli": "^5.1.0",
    "expo": "^55.0.23",
    "expo-image": "~55.0.11",
    "expo-keep-awake": "~55.0.8",
    "expo-location": "~55.1.12",
    "expo-maps": "~55.0.21",
    "expo-speech": "~55.0.16",
    "lucide-react-native": "^1.28.0",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-builder-bob": "^0.40.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-svg": "15.15.3",
    "typescript": "~5.9.2",
    "vitest": "^3.2.7"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "dependencies": {
    "@turf/bearing": "^7.4.0",
    "@turf/distance": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/nearest-point-on-line": "^7.4.0"
  }
}